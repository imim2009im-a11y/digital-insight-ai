# Copy to .env locally and replace values with environment-specific settings.
# Never commit real credentials, tokens, private keys, or database URLs.

# Nested ai-tools-directory application
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional MongoDB API / migration service
PORT=3000
MONGODB_URI=
TARGET_MONGODB_URI=
MIGRATE_ON_START=false
MONGODB_DB=digitalinsightai
ALLOWED_ORIGINS=https://digitalinsightai.com
